FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# brew requires build-essential, procps, curl, git
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash testuser && \
    echo 'testuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

USER testuser
WORKDIR /home/testuser
ENV HOME=/home/testuser

# Install homebrew (linuxbrew)
RUN NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

ENV PATH="/home/linuxbrew/.linuxbrew/bin:/home/linuxbrew/.linuxbrew/sbin:${PATH}"

# Install fish and brew packages (mirrors run_install-brew.sh.tmpl)
RUN brew install \
    fish \
    bat \
    bat-extras-batman \
    btop \
    hurl \
    jj \
    pcre2 \
    slides \
    xclip

# Install mise
RUN curl https://mise.run | sh

ENV PATH="/home/testuser/.local/bin:${PATH}"

# Install chezmoi
RUN sh -c "$(curl -fsLS get.chezmoi.io)" -- -b /home/testuser/.local/bin

COPY --chown=testuser:testuser . /home/testuser/.local/share/chezmoi/

# Deploy file structure (no scripts — fish not yet on PATH as login shell)
RUN chezmoi apply --exclude scripts

# Bootstrap fisher and install plugins using brew fish
RUN /home/linuxbrew/.linuxbrew/bin/fish -c "\
    curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && \
    fisher install jorgebucaran/fisher && \
    fisher install < ~/.config/fish/fish_plugins && \
    _fisher_sync_chezmoiignore \
"

CMD ["/home/linuxbrew/.linuxbrew/bin/fish"]
