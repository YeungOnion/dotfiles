#!/bin/bash
set -eufo pipefail

{{- $vars := dict }}
{{- range $k, $v := .fish_universal }}
  {{- $_ := set $vars $k $v }}
{{- end }}
{{- if .java_home }}
  {{- $_ := set $vars "JAVA_HOME" .java_home }}
{{- end }}

# universal config: {{ $vars | toJson }}

if command -v fish &>/dev/null; then
    # Quoted heredoc: bash passes it through untouched. Each value is a fish
    # single-quoted string, where only \ and ' are special, so values stay verbatim.
    fish <<'FISH'
{{- range $k, $v := $vars }}
set -Ux {{ $k }} '{{ toString $v | replace "\\" "\\\\" | replace "'" "\\'" }}'
{{- end }}
FISH
fi
