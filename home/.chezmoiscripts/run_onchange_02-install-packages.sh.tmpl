#!/bin/bash
set -ufo pipefail

# -- PATH setup ---------------------------------------------------------------
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}
. "$HOME/.cargo/env"
export PATH="$HOME/.local/bin:$PATH"

# -- Installers ---------------------------------------------------------------
{{- /* tap formulas install only when chezmoi init stored a boolean true for their tap
       (a hand-edited string such as "false" must not count) */}}
{{- $trust := get . "brew_tap_trust" | default dict }}
{{- $tapTrusted := list }}
{{- $tapUnanswered := list }}
{{- $tapDeclined := list }}
{{- range get . "brew_tap_packages" | default list }}
{{-   $tap := regexReplaceAll "/[^/]*$" . "" }}
{{-   $answer := get $trust $tap }}
{{-   if and (kindIs "bool" $answer) $answer }}
{{-     $tapTrusted = append $tapTrusted . }}
{{-   else if hasKey $trust $tap }}
{{-     $tapDeclined = append $tapDeclined . }}
{{-   else }}
{{-     $tapUnanswered = append $tapUnanswered . }}
{{-   end }}
{{- end }}
install_brew() {
{{- range $tapUnanswered }}
    echo "⏭  skipping {{ . }}: its tap is not trusted yet (answer the prompt in chezmoi init)"
{{- end }}
{{- range $tapDeclined }}
    echo "⏭  skipping {{ . }}: its tap was declined (set brew_tap_trust with chezmoi edit-config)"
{{- end }}
    brew install {{ .brew_packages | join " " }}{{ with index . (printf "brew_packages_%s" .chezmoi.os) }} {{ . | join " " }}{{ end }}{{ range $tapTrusted }} {{ . }}{{ end }}
}

install_cargo() {
{{ if or .cargo_plugins .cargo_binaries -}}
    cargo binstall --locked --no-confirm --disable-strategies compile{{ range .cargo_plugins }} cargo-{{ . }}{{ end }}{{ range .cargo_binaries }} {{ . }}{{ end }}
{{ end -}}
}

install_uv() {
{{ range .uv_packages -}}
    uv tool install {{ . }} &
{{ end -}}
    wait
}

# -- Concurrent installs ---------------------------------------------------------
install_brew  & brew_pid=$!
install_cargo & cargo_pid=$!
install_uv    & uv_pid=$!

brew_ok=0;  wait $brew_pid  || brew_ok=$?
cargo_ok=0; wait $cargo_pid || cargo_ok=$?
uv_ok=0;    wait $uv_pid    || uv_ok=$?

[[ $brew_ok  -eq 0 ]] || echo "⚠  brew install exited $brew_ok — check output above"
[[ $cargo_ok -eq 0 ]] || echo "⚠  cargo binstall exited $cargo_ok — check output above"
[[ $uv_ok    -eq 0 ]] || echo "⚠  uv tool install exited $uv_ok — check output above"
