#!/bin/bash
set -ufo pipefail

# -- PATH setup ---------------------------------------------------------------
{{ if eq .chezmoi.os "darwin" -}}
eval "$(/opt/homebrew/bin/brew shellenv)"
{{ else -}}
eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
{{ end -}}
. "$HOME/.cargo/env"
export PATH="$HOME/.local/bin:$PATH"

# -- Installers ---------------------------------------------------------------
{{- /* tap formulas install only when chezmoi init stored trust for their tap */}}
{{- $trust := get . "brew_tap_trust" | default dict }}
{{- $tapTrusted := list }}
{{- $tapSkipped := list }}
{{- range get . "brew_tap_packages" | default list }}
{{-   if get $trust (regexReplaceAll "/[^/]*$" . "") }}
{{-     $tapTrusted = append $tapTrusted . }}
{{-   else }}
{{-     $tapSkipped = append $tapSkipped . }}
{{-   end }}
{{- end }}
install_brew() {
{{- range $tapSkipped }}
    echo "⏭  skipping {{ . }}: its tap is not trusted (answer the prompt in chezmoi init)"
{{- end }}
    brew install {{ .brew_packages | join " " }}{{ with index . (printf "brew_packages_%s" .chezmoi.os) }} {{ . | join " " }}{{ end }}{{ range $tapTrusted }} {{ . }}{{ end }}
}

install_cargo() {
{{ if or .cargo_plugins .cargo_binaries -}}
    cargo binstall --locked --no-confirm --disable-strategies compile{{ range .cargo_plugins }} cargo-{{ . }}{{ end }}{{ range .cargo_binaries }} {{ . }}{{ end }}
{{ end -}}
}

install_uv() {
{{ range .uv_packages -}}
    uv tool install {{ . }} &
{{ end -}}
    wait
}

# -- Concurrent installs ---------------------------------------------------------
install_brew  & brew_pid=$!
install_cargo & cargo_pid=$!
install_uv    & uv_pid=$!

brew_ok=0;  wait $brew_pid  || brew_ok=$?
cargo_ok=0; wait $cargo_pid || cargo_ok=$?
uv_ok=0;    wait $uv_pid    || uv_ok=$?

[[ $brew_ok  -eq 0 ]] || echo "⚠  brew install exited $brew_ok — check output above"
[[ $cargo_ok -eq 0 ]] || echo "⚠  cargo binstall exited $cargo_ok — check output above"
[[ $uv_ok    -eq 0 ]] || echo "⚠  uv tool install exited $uv_ok — check output above"
