#!/bin/bash
set -eufo pipefail
# Runs after files are deployed, so ~/.config/fish/fish_plugins (rendered from
# home/.chezmoidata/fish.json fish_plugins) exists for `fisher update` to read.
# Re-runs when the list changes: {{ .fish_plugins | join " " }}

{{ if eq .chezmoi.os "darwin" -}}
fish_bin={{ or (lookPath "fish") "/opt/homebrew/bin/fish" }}
{{ else -}}
fish_bin={{ or (lookPath "fish") "/home/linuxbrew/.linuxbrew/bin/fish" }}
{{ end -}}

# `fisher update` syncs to the deployed file, removing plugins it lacks. When this script runs
# without the file (`chezmoi apply --include=scripts`), refuse rather than act on a stale list.
plugins_file="$HOME/.config/fish/fish_plugins"
want=({{ range .fish_plugins }}{{ . | quote }} {{ end }})
if [ "$(cat "$plugins_file" 2>/dev/null)" != "$(printf '%s\n' "${want[@]}")" ]; then
    echo "fisher: $plugins_file is stale; run 'chezmoi apply $plugins_file' first" >&2
    exit 1
fi

"$fish_bin" <<'FISH'
if not functions -q fisher
    # `| source` returns source's status (0 on empty input), so check the result
    curl -fsSL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source
    functions -q fisher; or exit 1
end
fisher update
# fisher update exits 0 when a single download fails; confirm every listed plugin landed
{{ range .fish_plugins -}}
contains -- {{ . | lower | quote }} (string lower -- $_fisher_plugins)
or begin; echo "fisher: {{ . }} not installed" >&2; exit 1; end
{{ end -}}
FISH
