[Unit]
Description=Persistent tmux session for Claude Code

[Service]
Type=forking
Environment=PATH=/home/linuxbrew/.linuxbrew/bin:/home/onion/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/linuxbrew/.linuxbrew/bin/tmux new-session -d -s cc -c %h
ExecStop=/home/linuxbrew/.linuxbrew/bin/tmux kill-session -t cc
Restart=on-failure

[Install]
WantedBy=default.target
