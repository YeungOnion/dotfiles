# $XDG_CONFIG/fish/config.fish
# Owns setup, in line order: environment, Homebrew, PATH, interactive settings, tool
# hooks. conf.d/ holds only self-contained snippets; fish runs them before this file.

# for stuff in path that needs a path or targets
set -gx --path RUSTUP_HOME $HOME/.rustup
set -gx --path CARGO_HOME $HOME/.cargo
set -gx --path GOPATH $HOME/.go
set -gx GOBIN $GOPATH/bin
set -gx CC cc

# Nix: its own snippet (session-only fish_add_path, sourced once); skipped without Nix.
# Before Homebrew, so brew's tools keep precedence where both provide one.
set -l nix_fish /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.fish
test -f $nix_fish; and source $nix_fish

# Homebrew: prefix differs by OS; shellenv also sets HOMEBREW_* and MANPATH/INFOPATH
{{ if eq .chezmoi.os "darwin" -}}
set -l brew /opt/homebrew/bin/brew
{{- else -}}
set -l brew /home/linuxbrew/.linuxbrew/bin/brew
{{- end }}
test -x $brew; and $brew shellenv fish | source

# PATH is declarative: --global --path changes this session only, so removing an entry
# from data removes it from PATH (nothing is saved to universal fish_user_paths).
# shared: chezmoi data fish_paths (schema-validated, unquoted so ~ and $VAR expand)
# machine-only: fish_paths_local in ~/.config/chezmoi/chezmoi.toml (quoted verbatim)
{{- $paths := .fish_paths }}
{{- range (get . "fish_paths_local" | default list) }}
{{- $paths = append $paths (printf "'%s'" (toString . | replace "\\" "\\\\" | replace "'" "\\'")) }}
{{- end }}
fish_add_path --global --path {{ $paths | join " " }}

if status is-interactive

    # shell prompt
    set -gx hydro_multiline true

    # fzf related
    set fd_cmd (command -s fd || command -s fdfind)
    set -g FZF_DEFAULT_COMMAND $fd_cmd
    set -g FZF_DEFAULT_OPTS --ansi

    # pager related
    if command -q bat
        set -gx PAGER bat -p
        set -g MANPAGER batman
    else
        set -gx PAGER cat
    end

    # for tools I use directly and fisher funcs
    set -gx fzf_fd_opts --hidden --exclude="**/target/*" \
        --exclude="**/build/*" --exclude="**/{.mypy,.ruff}_cache/*" \
        --exclude="**/.git/{objects,refs,logs}/*" \
        --exclude="**/.pixi/env/*"
    set -gx fzf_git_log_opts --preview-window "down,70%"
    source $__fish_config_dir/aliases.fish
    set -g sponge_purge_only_on_exit true

    # tool hooks, after PATH is set; each silent when its tool is missing
    command -q mise; and mise activate fish | source  # ~250 ms (measured, accepted)
    command -q direnv; and direnv hook fish | source
    # zoxide keeps the `z` command; history is per machine in ~/.local/share/zoxide
    command -q zoxide; and zoxide init fish --cmd z | source
end
