# Generated under ~/.config/fish by fish or other tools; not fisher-owned
.config/fish/completions/chezmoi.fish
.config/fish/completions/swamp.fish
.config/fish/conf.d/fish_frozen_key_bindings.fish
# tmux-cc keeps a tmux session for remote Claude Code; only on the cc host (chezmoi init)
{{ if not (get . "cc_host") -}}
.config/systemd/user/tmux-cc.service
{{ end -}}
# Keys and machine-only ssh config (config.local) never enter the repo
.ssh/*
!.ssh/config
# fisher-owned files, read from fisher's own record at render time.
# Plain `fish -c`: --no-config would hide universal variables.
{{ if lookPath "fish" -}}
{{ range (output "fish" "-c" "for v in (set -Un | string match '_fisher_*_files'); string replace -r '^~/' '' -- $$v; end; true" | splitList "\n") -}}
{{ if hasPrefix ".config/fish/" . }}{{ . }}
{{ end -}}
{{ end -}}
{{- end }}
